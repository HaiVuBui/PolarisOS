{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "$HOME/.config/fastfetch/nixos.txt",
        // "height": 20,
        // "position": "top",
        "padding": {
          "top": 1,
          // "left": 1,
          // "right": 1
        },
        "color": {
            "1": "magenta"
        },
    },
    "display": {
        "separator": " : "
    },
    "modules": [
        {
            "type": "os",
            "key": " OS",
            "keyColor": "green"
        },
        {
            "type": "kernel",
            "key": " Kernel",
            "keyColor": "green"
        },
        {
            "type": "command",
            "key": "󱦟 OS Age ",
            "keyColor": "red",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
        },
        {
            "type": "packages",
            "key": " Packages",
            "keyColor": "red"
        },
        {
            "type": "cpu",
            "format": "{1}",
            "key": " CPU",
            "keyColor": "blue"
        },
        {
            "type": "gpu",
            "format": "{2}",
            "key": "󰢮 GPU",
            "keyColor": "blue"
        },
        {
            "type": "board",
            "key": "󰻠 Board",
            "keyColor": "blue"
        },
        {
            "type": "gpu",
            "format": "{3}",
            "key": " GPU Driver",
            "keyColor": "blue"
        },
        {
            "type": "disk",
            "key": "󰋊 Disks",
            "keyColor": "magenta"
        },
        "break",
        {
            "type": "title",
            "key": "󰀉"
        },
        {
            "type": "terminal",
            "key": " Terminal",
            "keyColor": "cyan"
        },
        {
            "type": "wm",
            "key": " WM",
            "keyColor": "green"
        },
        {
            "type": "display",
            "key": "󰹑 Display",
            "keyColor": "green"
        },
        {
            "type": "uptime",
            "key": "󱫐 Uptime ",
            "keyColor": "red"
        },
        {
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "circle"
        },
    ]
}
