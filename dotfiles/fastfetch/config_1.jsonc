{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  
  "logo": {
      "source": "$HOME/.config/fastfetch/nixos.txt",
      // "height": 20,
      "position": "top",
      "padding": {
        "top": 1,
        "left": 1,
        "right": 1
      }
  },

  "display": {
    "separator": " 󰑃  "
  },

  "modules": [
    "break",
    {
      "type": "os",
      "key": " DISTRO",
      "keyColor": "yellow"
    },
    {
      "type": "kernel",
      "key": "│ ├",
      "keyColor": "yellow"
    },
    {
    "type": "packages",
    "key": "│ ├󰏖",
    "keyColor": "yellow"
    },
    {
    "type": "shell",
    "key": "│ └",
    "keyColor": "yellow"
    },
    {
    "type": "wm",
    "key": " DE/WM",
    "keyColor": "blue"
    },
    {
    "type": "wmtheme",
    "key": "│ ├󰉼",
    "keyColor": "blue"
    },
    {
    "type": "icons",
    "key": "│ ├󰀻",
    "keyColor": "blue"
    },
    {
        "type": "cursor",
        "key": "│ ├",
        "keyColor": "blue",
    },
    {
        "type": "terminalfont",
        "key": "│ ├",
        "keyColor": "blue",
    },
    {
    "type": "terminal",
    "key": "│ └",
    "keyColor": "blue"
    },
    {
    "type": "host",
    "key": "󰌢 SYSTEM",
    "keyColor": "cyan"
    },
    {
    "type": "cpu",
    "key": "│ ├󰻠",
    "keyColor": "cyan"
    },
    {
    "type": "gpu",
    "key": "│ ├󰻑",
    "format": "{2}",
    "keyColor": "cyan"
    },
    {
            "type": "display",
    "key": "│ ├󰍹",
    "keyColor": "cyan",
    "compactType": "original-with-refresh-rate"
    },
    {
    "type": "memory",
    "key": "│ ├󰾆",
    "keyColor": "cyan"
    },
    {
    "type": "disk",
    "key": "│ ├󰋊" ,
    "keyColor": "cyan"
    },
    {
    "type": "swap",
    "key": "│ ├󰓡",
    "keyColor": "cyan"
    },
    {
    "type": "uptime",
    "key": "│ ├󰅐",
    "keyColor": "cyan"
    },
    {
    "type": "command",
    "key": "│ ├󱦟",
    "keyColor": "cyan",
    "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
    },
    {
    "type": "display",
    "key": "│ └󰍹",
    "keyColor": "cyan"
    },
    {
    "type": "sound",
    "key": " AUDIO",
    "format": "{2}",
    "keyColor": "magenta"
    },
    {
    "type": "player",
    "key": "│ ├󰥠",
    "keyColor": "magenta"
    },
    {
    "type": "media",
    "key": "│ └󰝚",
    "keyColor": "magenta"
    },
    {
    "type": "custom",
    "format": "\u001b[90m  \u001b[31m  \u001b[32m  \u001b[33m  \u001b[34m  \u001b[35m  \u001b[36m  \u001b[37m  "
    },
    "break",
    ]
}
