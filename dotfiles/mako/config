font=JetBrains Mono Nerd Font 12
width=350
height=150
margin=20
padding=15
border-size=2
border-radius=6
on-button-left=dismiss
on-button-right=exec makoctl mode -a preview

# Everforest Light Soft
background-color=#f3ead3
text-color=#5c6a72
border-color=#8da101
progress-color=over #eae4ca

icons=1
max-icon-size=48

# --- CHANGED HERE ---
default-timeout=0
# --------------------

ignore-timeout=1
group-by=app-name

[urgency=low]
border-color=#35a77c

[urgency=normal]
border-color=#8da101

[urgency=high]
border-color=#f85552
# default-timeout=0 is now redundant here since it's global, but fine to keep

[mode=preview]
height=1000
width=500
on-button-right=exec makoctl mode -r preview
