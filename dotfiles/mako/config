font=JetBrains Mono Nerd Font 12
width=350
height=150
margin=20
padding=15
border-size=2
border-radius=6
on-button-left=dismiss
on-button-right=exec makoctl mode -a preview

# Gruvbox Material Dark Medium
background-color=#282828
text-color=#d4be98
border-color=#a89984
progress-color=over #32302f

icons=1
max-icon-size=48

# --- CHANGED HERE ---
default-timeout=0
# --------------------

ignore-timeout=1
group-by=app-name

[urgency=low]
border-color=#a9b665

[urgency=normal]
border-color=#a89984

[urgency=high]
border-color=#ea6962
# default-timeout=0 is now redundant here since it's global, but fine to keep

[mode=preview]
height=1000
width=500
on-button-right=exec makoctl mode -r preview
