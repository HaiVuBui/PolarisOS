font=JetBrains Mono Nerd Font 12
width=350
height=150
margin=20
padding=15
border-size=2
border-radius=6
on-button-left=dismiss
on-button-right=exec makoctl mode -a preview

# Rose Pine Dawn
background-color=#faf4ed
text-color=#575279
border-color=#d7827e
progress-color=over #f2e9e1

icons=1
max-icon-size=48

# --- CHANGED HERE ---
default-timeout=0
# --------------------

ignore-timeout=1
group-by=app-name

[urgency=low]
border-color=#286983

[urgency=normal]
border-color=#d7827e

[urgency=high]
border-color=#b4637a
# default-timeout=0 is now redundant here since it's global, but fine to keep

[mode=preview]
height=1000
width=500
on-button-right=exec makoctl mode -r preview
