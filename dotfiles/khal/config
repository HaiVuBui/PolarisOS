[calendars]

  [[google]]
    path = ~/.calendars/google/
    type = calendar
    readonly = true

  [[outlook]]
    path = ~/.calendars/outlook/
    type = calendar
    readonly = true

  [[local]]
    path = ~/.calendars/local/
    type = calendar
    readonly = false

[locale]
timeformat = %H:%M
dateformat = %Y-%m-%d
longdateformat = %Y-%m-%d
datetimeformat = %Y-%m-%d %H:%M
longdatetimeformat = %Y-%m-%d %H:%M
local_timezone = Asia/Ho_Chi_Minh
default_timezone = Asia/Ho_Chi_Minh
