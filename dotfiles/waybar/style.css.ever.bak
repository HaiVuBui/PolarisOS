* {
    border: none;
    border-radius: 0;
    font-family: JetBrainsMono Nerd Font Mono, monospace;
    font-weight: bold;
    font-size: 14px;
    min-height: 0;
}

window#waybar {
    background: transparent;
    color: #d3c6aa;
}

#workspaces button {
    padding: 5px;
    color: #859289;
    margin-right: 5px;
}

#workspaces button.active {
    color: #a7c080;
}

#workspaces button.focused {
    color: #2b3339;
    background: #a7c080;
    border-radius: 10px;
}

#workspaces button.urgent {
    color: #2b3339;
    background: #e67e80;
    border-radius: 10px;
}

#workspaces button:hover {
    background: #83c092;
    color: #2b3339;
    border-radius: 10px;
}

#window,
#clock,
#custom-nixos,
#custom-nvidia,
#battery,
#pulseaudio,
#network,
#cpu,
#memory,
#workspaces,
#tray,
#backlight {
    background: #323c41;
    padding: 0px 10px;
    margin: 3px 0px;
    margin-top: 5px;
    /* border: 1px solid #181825; */
    /* border-radius: 10px 0px 0px 10px; */
}

#tray {
    border-radius: 10px;
    margin-right: 10px;
}

#workspaces {
    background: #323c41;
    border-radius: 10px;
    margin-left: 10px;
    padding-right: 0px;
    padding-left: 5px;
}

#cpu {
    border-radius: 10px 0px 0px 10px;
    margin-right: 0px;
}

#memory {
    border-radius: 0px 10px 10px 0px;
    margin-right: 10px;
}

#window {
    border-radius: 10px;
    margin-left: 60px;
    margin-right: 60px;
}

#clock {
    color: #d3c6aa;
    border-radius: 10px 10px 10px 10px;
    margin-left: 5px;
    border-right: 0px;
}

#custom-nixos {
    color: #2b3339;
    background: #a7c080;
    padding: 0px 8px;
    margin: 5px 6px 3px 10px;
    border-radius: 10px;
}

#custom-nvidia {
    color: #a7c080;
    border-radius: 0px;
}

#network {
    color:  #d3c6aa;
    border-radius: 10px 0px 0px 10px;

}

#pulseaudio {
    color: #d3c6aa;
    border-left: 0px;
    border-right: 0px;
}

#pulseaudio.microphone {
    color: #d3c6aa;
    border-radius: 0px 10px 10px 0px;
    border-left: 0px;
    border-right: 0px;
    margin-right: 5px;
}

#battery {
    color:#d3c6aa;
    border-radius: 0px 10px 10px 0px;
    margin-right: 10px;
}
