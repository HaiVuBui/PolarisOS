{
    "workbench.colorTheme": "Rosé Pine Dawn", // set theme
    "window.menuBarVisibility": "compact", // hide menu
    "window.commandCenter": false, // hide command center
    "workbench.layoutControl.enabled": false, // hide layout control
    "workbench.browser.showInTitleBar": false, // hide browser
    "workbench.sideBar.location": "right", // right sidebar
    "workbench.panel.defaultLocation": "left", // left panel
    "extensions.experimental.affinity": {
        "asvetliakov.vscode-neovim": 1 // nvim-vscode compatibility
    },
    "pasteImage.path": "${currentFileDir}/assets", // paste image path
    "chat.disableAIFeatures": true, // no AI shits
    "git.openRepositoryInParentFolders": "never", // stop git-open-parent
    "search.exclude": { // excluded search paths
        "**/node_modules": true,
        "**/.git": true,
        "**/dist": true,
        "**/result": true,
        "**/.direnv": true
    },
    "extensions.ignoreRecommendations": true, // no extension recommendation
    "telemetry.telemetryLevel": "off", // disable telemetry
    "update.mode": "none", // disable editor update checks
    "update.showReleaseNotes": false, // no release notes popups
    "extensions.autoCheckUpdates": false, // disable extension update checks
    "extensions.autoUpdate": false, // disable extension auto-updates
    "workbench.enableExperiments": false, // disable experiments
    "vscode-neovim.neovimClean": true, // stop nvim verbose
    "diffEditor.hideUnchangedRegions.enabled": true,
    "editor.minimap.enabled": false, // hide minimap in scroll bar
}
